{
  "name": "@ihsan/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 execute ihsancenter --local --file=./migrations/0001_init.sql && wrangler d1 execute ihsancenter --local --file=./migrations/0002_seed.sql",
    "db:reset:local": "rm -rf .wrangler/state/v3/d1 && npm run db:migrate:local",
    "db:console": "wrangler d1 execute ihsancenter --local --command",
    "test": "vitest run"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wrangler": "^3.99.0"
  }
}
