{
  "name": "ihsancenter",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace @ihsan/api",
    "dev:web": "npm run dev --workspace @ihsan/web",
    "test": "npm run test --workspace @ihsan/api",
    "db:migrate:local": "npm run db:migrate:local --workspace @ihsan/api",
    "db:reset:local": "npm run db:reset:local --workspace @ihsan/api",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.41"
  }
}
